# =============================================
# CAD-BACK - Environment Variables (EXAMPLE)
# =============================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/cad?schema=public"

PORT=3000

JWT_SECRET=""
JWT_EXPIRES_IN="1d"

JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:4200"

NODE_ENV=development
